{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: Build & Run (single file, Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "g++ -std=c++17 -g -O0 -Wall -Wextra -Wshadow -Wconversion -pedantic \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "C++: Build Only (single file, Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "g++ -std=c++17 -g -O0 -Wall -Wextra -Wshadow -Wconversion -pedantic \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\""
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C++: Build & Run (single file, Release -O2)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "g++ -std=c++17 -O2 -pipe -DNDEBUG -Wall -Wextra \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\""
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C++: Build & Run (ASan+UBSan)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "g++ -std=c++17 -g -O1 -fno-omit-frame-pointer -fsanitize=address,undefined -Wall -Wextra \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && ASAN_OPTIONS=detect_leaks=1 \"${fileDirname}/${fileBasenameNoExtension}\""
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C++: Build & Run (all .cpp in folder)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "g++ -std=c++17 -g -O0 -Wall -Wextra \"${fileDirname}\"/*.cpp -o \"${fileDirname}/a.out\" && \"${fileDirname}/a.out\""
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C++: Run (no build)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "\"${fileDirname}/${fileBasenameNoExtension}\""
            ],
            "problemMatcher": []
        },
        {
            "label": "C++: Run (stdin input.txt)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "\"${fileDirname}/${fileBasenameNoExtension}\" < \"${fileDirname}/input.txt\""
            ],
            "problemMatcher": []
        },
        {
            "label": "C++: Clean (binary)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "rm -f \"${fileDirname}/${fileBasenameNoExtension}\" \"${fileDirname}/a.out\""
            ],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        }
    ]
}